{
  "name": "basic-ftp",
  "version": "6.2.0",
  "description": "FTP client for Node.js, supports FTPS over TLS, IPv6, Async/Await, and Typescript.",
  "main": "dist/index",
  "types": "dist/index",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run lint && tsc && node --test test/*Spec.js",
    "prepare": "tsc",
    "test": "npm run prepublishOnly",
    "clean": "rm -rf dist",
    "lint": "eslint \"./src/**/*.ts\"",
    "lint-fix": "eslint --fix \"./src/**/*.ts\"",
    "dev": "npm run clean && tsc --watch",
    "tdd": "node --test --watch test/*Spec.js",
    "buildOnly": "tsc",
    "test:integration": "npm run buildOnly && node --test test/integration/*Spec.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patrickjuchli/basic-ftp.git"
  },
  "author": "Patrick Juchli <patrickjuchli@gmail.com>",
  "license": "MIT",
  "keywords": [
    "ftp",
    "ftps",
    "promise",
    "async",
    "await",
    "tls",
    "ipv6",
    "typescript"
  ],
  "engines": {
    "node": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0",
    "testcontainers": "12.0.4",
    "typescript": "6.0.3"
  }
}
